# Gin
GIN_MODE=debug
PORT=8802

# Database (MySQL DSN)
# format: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
DB_URL=user:password@tcp(127.0.0.1:3306)/db_notes?charset=utf8mb4&parseTime=True&loc=Local

# JWT Auth
AUTH_JWT_ENABLE=true
AUTH_JWT_TOKEN_SECRET=change-me-to-a-long-random-secret
AUTH_JWT_TOKEN_EXPIRED_MS=3600000

# Redis
REDIS_ENABLE=false
REDIS_HOST=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Rate limiter
LIMITER_MAX_REQUEST_PER_SECOND=10

# Logging
LOG_MODE=DEBUG
LOG_CLEAR=false

# TLS
TLS=false
TLS_CERT_FILE=cert/server.crt
TLS_KEY_FILE=cert/server.key

# Files
DIR_FILES=./files
